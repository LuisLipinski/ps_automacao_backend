{
  "name": "ps_automacao_backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "cross-env PS_EMPRESA_URL=https://ps-empresa.onrender.com playwright test",
    "test:local": "cross-env PS_EMPRESA_URL=http://localhost:8081 playwright test",
    "smoke": "playwright test tests/api/**/smoke",
    "regression": "playwright test tests/api/**/regression",
    "empresa": "playwright test --project=ps_empresa",
    "empresa:local": "cross-env PS_EMPRESA_URL=http://localhost:8081 playwright test --project=ps_empresa",
    "empresa:smoke": "playwright test tests/api/ps_empresa/smoke --project=ps_empresa",
    "empresa:smoke:local": "cross-env PS_EMPRESA_URL=http://localhost:8081 playwright test tests/api/ps_empresa/smoke --project=ps_empresa",
    "empresa:smoke-security:local": "cross-env PS_EMPRESA_URL=http://localhost:8081 playwright test --grep \"@smoke|@security\" --project=ps_empresa",
    "empresa:smoke-security:render": "cross-env PS_EMPRESA_URL=https://ps-empresa.onrender.com playwright test --grep \"@smoke|@security\" --project=ps_empresa",
    "empresa:smoke:render": "cross-env PS_EMPRESA_URL=https://ps-empresa.onrender.com playwright test tests/api/ps_empresa/smoke --project=ps_empresa",
    "empresa:regression": "playwright test tests/api/empresa/regression --project=empresa",
    "empresa:regression:local": "cross-env PS_EMPRESA_URL=http://localhost:8081 playwright test tests/api/ps_empresa/regression --project=ps_empresa",
    "empresa:regression:render": "cross-env PS_EMPRESA_URL=https://ps-empresa.onrender.com playwright test tests/api/ps_empresa/regression --project=ps_empresa",
    "contrato": "playwright test --project=contrato",
    "contrato:smoke": "playwright test tests/api/contrato/smoke --project=contrato",
    "contrato:regression": "playwright test tests/api/contrato/regression --project=contrato",
    "report": "playwright show-report"
  },
  "keywords": [],
  "author": "Luis Henrique Lipinski",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@types/ajv": "^0.0.5",
    "@types/dotenv": "^6.1.1",
    "@types/node": "^25.2.3",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "cross-env": "^10.1.0",
    "eslint": "^10.1.0",
    "prettier": "^3.8.1"
  },
  "dependencies": {
    "@faker-js/faker": "^10.3.0",
    "ajv": "^8.18.0",
    "cpf-cnpj-validator": "^1.0.3",
    "dotenv": "^17.3.1",
    "playwright": "^1.58.2"
  }
}
