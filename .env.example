# URLs locais (não contém segredos)
PS_EMPRESA_URL=http://localhost:8081
PS_CONTRATO_URL=http://localhost:8082

# Defina localmente ou via GitHub/CI secrets. Nunca versionar valores reais.
PS_EMPRESA_INTERNAL_KEY=replace-me
PS_CONTRATO_INTERNAL_KEY=replace-me

# Habilite apenas em ambiente efêmero/QA: cria dados de lifecycle entre os MS.
RUN_DESTRUCTIVE_INTEGRATION=false
